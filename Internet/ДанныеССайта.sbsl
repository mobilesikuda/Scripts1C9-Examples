

метод Скрипт()
    знч Запрос1 = КлиентHttp.ЗапросGet("https://sikuda.ru/mobile/loc/1cema.xml")
    исп Результат1 = Запрос1.Выполнить()

    знч Чтение = новый ЧтениеXml(Результат1.Тело)
    пер Счетчик = 10
    пока Чтение.Следующий()
        // Читаем имя текущего узла
        если Чтение.ВидУзла == ВидУзлаXml.НачалоЭлемента 
            //СодержимоеXML.Добавить("Имя узла - " + Чтение.Имя)
            Консоль.Записать(Чтение.Имя)
            Счетчик=Счетчик-1
            если Счетчик == 0 
                прервать
            ;
        ;
    ;
        
    знч Запрос2 = КлиентHttp.ЗапросGet("http://sikuda.ru/spark/catalogs.json")
    исп Результат2 = Запрос2.Выполнить()
    пер МассивПоговорок: неизвестно = СериализацияJson.ПрочитатьОбъект(Результат2.Тело)
    //пер Настройки: НастройкиЧтенияОбъектовJson
    //пер МассивПоговорок = ПрочитатьОбъект(Результат2.Тело,Тип<Массив<Объект?>>, Настройки )
    если МассивПоговорок.ПолучитьТип() == Тип<Массив<Объект?>> 
        Консоль.Записать("Прочитал элементов - "+МассивПоговорок?.Граница()+1)
    иначе
        Консоль.Записать("Не могу прочитать данные")            
    ;        //Результат.Закрыть()
    //для стр из СодержимоеXML
    //    Консоль.Записать(стр)
    //;

;