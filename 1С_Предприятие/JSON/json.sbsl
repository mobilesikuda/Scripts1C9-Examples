метод Скрипт()
    ПрочитатьJson()
;

метод ПрочитатьJson()

    знч textJson2 = 
    "
    [
    {
    \"id\":\"18\"
    }
    ]"

    знч textJson = 
    "
    [
    {
    \"id\":\"18\",
    \"name\":\"А воз и ныне там. \",
    \"title\":\"(Цитата из басни И. А. Крылова. Смысл поговорки в том, что не смотря на все разговоры и обещания по какому-либо делу, ничего кроме болтовни не сделано.)\"
    },
    {
    \"id\":\"20\",
    \"name\":\"А где щи, тут и нас ищи. \",
    \"title\":\"(Русская пословица, означает что человек пытается стремиться туда, где хорошо, где сытая, богатая жизнь.)\"
    }]"

    знч Чтение = новый ЧтениеJson(textJson)
    пока Чтение.Следующий()
        //Консоль.Записать(Чтение.ВидУзла)
        //Консоль.Записать(Чтение.Значение)
        пер имяСвойство = ""
        пер Данные: Соответствие<Строка, Строка>
        если Чтение.ВидУзла == ВидУзлаJson.НачалоОбъекта
        
            Чтение.Следующий()
            пока Чтение.ВидУзла != ВидУзлаJson.КонецОбъекта
                если Чтение.ВидУзла == ВидУзлаJson.ИмяСвойства 
                    имяСвойство = Чтение.Значение
                иначе
                    Данные.Вставить(имяСвойство, Чтение.Значение)
                ;
                Чтение.Следующий()
            ;
            //Пословица.Записать()
            для стр из Данные
                Консоль.Записать(стр.Ключ +":"+ стр.Значение)    
            ;
        ;
    ;
;
