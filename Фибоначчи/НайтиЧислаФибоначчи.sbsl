// Импорт скрипта "Фибоначчи.sbsl".
// Скрипт находится в том же каталоге, что и текущий скрипт.
// --- executor.cmd НайтиЧислаФибоначчи.sbsl 12
#требуется Фибоначчи.sbsl

метод Скрипт()
    пер ЧислаФибоначчи: ЧитаемыйМассив<Число>?
    знч КоличествоЧисел = Консоль.СчитатьЧисло("Введите количесво чисел: ")
        
    попытка
        ЧислаФибоначчи = Фибоначчи.ВернутьЧислаФибоначчи(Текст = "", КоличествоЧисел = КоличествоЧисел)
    поймать Исключение: ИсключениеНедопустимыйАргумент
        выбросить Исключение
    ;
    для ном = 1 по КоличествоЧисел
       Консоль.Записать(ном +" -> "+ ЧислаФибоначчи[ном])
    ;
    
    Консоль.Записать(ДатаВремя.Сейчас())
    пер ЧислоФибоначчи = Фибоначчи.ВернутьЧислоФибоначчиНеОптимально(КоличествоЧисел)
    Консоль.Записать(ЧислоФибоначчи)
    Консоль.Записать(ДатаВремя.Сейчас())
;