   

метод Скрипт()
    знч КоличествоЧисел = Консоль.СчитатьЧисло("Введите целове число: ")
        
    знч НачалоПРасчета  = ДатаВремя.Сейчас()
    пер ЧислоФибоначчи = ВернутьЧислоФибоначчиНеОптимально(КоличествоЧисел)
    Консоль.Записать("Результат:"+ЧислоФибоначчи)
    Консоль.Записать("Продолжительность:"+(ДатаВремя.Сейчас()-НачалоПРасчета))
; 

метод ВернутьЧислоФибоначчиНеОптимально(КоличествоЧисел: Число): Число
    
    если КоличествоЧисел <3
        возврат 1
    иначе
        возврат ВернутьЧислоФибоначчиНеОптимально(КоличествоЧисел-2) + ВернутьЧислоФибоначчиНеОптимально(КоличествоЧисел-1)
    ;      
;