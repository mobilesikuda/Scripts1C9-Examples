@Глобально
метод ВернутьЧислаФибоначчи(КоличествоЧисел: Число, Текст: Строка): ЧитаемыйМассив<Число>
    
    если Текст.Пусто() 
        Текст = "Количество чисел должно быть больше двух!"
    ;    
    
    если КоличествоЧисел < 2
        выбросить новый ИсключениеНедопустимыйАргумент( Текст )
    ;
    пер Числа: Массив<Число> = []
    Числа.Добавить(0)
    Числа.Добавить(1)
  
    для Номер = 2 по КоличествоЧисел
        Числа.Добавить(Числа.Получить(Номер - 1) + Числа.Получить(Номер - 2))
    ;
  
    возврат новый ЧитаемыйМассив<Число>(Числа)
;

@Глобально
метод ВернутьЧислоФибоначчиНеОптимально(КоличествоЧисел: Число): Число
    
    если КоличествоЧисел <3
        возврат 1
    иначе
        возврат ВернутьЧислоФибоначчиНеОптимально(КоличествоЧисел-2) + ВернутьЧислоФибоначчиНеОптимально(КоличествоЧисел-1)    
        
    ;    
    
;